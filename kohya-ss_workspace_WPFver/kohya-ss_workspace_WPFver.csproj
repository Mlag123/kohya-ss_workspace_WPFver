<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <RootNamespace>kohya_ss_workspace_WPFver</RootNamespace>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ApplicationIcon>favicon.ico</ApplicationIcon>
    </PropertyGroup>

    <!-- Ресурсы: иконка вшивается в сборку -->
    <ItemGroup>
        <Resource Include="favicon.ico" />
    </ItemGroup>

    <!-- FFmpeg: копируем нативные DLL в выходную папку -->
    <ItemGroup>
        <None Include="native\ffmpeg\*.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>runtimes\win-x64\native\%(Filename)%(Extension)</Link>
        </None>
    </ItemGroup>

    <!-- NuGet пакеты -->
    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="FFMediaToolkit" Version="4.8.1" />
        <PackageReference Include="MahApps.Metro" Version="3.0.0-rc0529" />
        <PackageReference Include="SkiaSharp" Version="4.156.0-preview.1.26512.10" />
        <PackageReference Include="SkiaSharp.Views.WPF" Version="4.156.0-preview.1.26512.10" />
    </ItemGroup>

</Project>