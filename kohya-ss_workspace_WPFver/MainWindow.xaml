<Controls:MetroWindow x:Class="kohya_ss_workspace_WPFver.MainWindow"
                      Icon="pack://application:,,,/favicon.ico"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:local="clr-namespace:kohya_ss_workspace_WPFver"
                      xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
                      mc:Ignorable="d"
                      Title="Kohya-ssWorkspace" Height="720" Width="1280">

    <Controls:MetroWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="#66000000" />
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#66000000" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#AA1E1E1E" />
                    <Setter Property="BorderBrush" Value="#FFFF6D00" />
                </Trigger>

                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF121212" />
                </Trigger>

                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#33FFFFFF" />
                    <Setter Property="Foreground" Value="#55FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#66000000" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Controls:MetroWindow.Resources>

    <!-- ParalaxContainer -->
    <Grid x:Name="ParallaxContainer" SizeChanged="ParallaxContainer_SizeChanged" ClipToBounds="True">

        <!-- 1. Backgroing -->
        <ItemsControl ItemsSource="{Binding Paws}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Path
                        Data="M 844.3, 1230.1 C 771.8, 1212.9, 715.1, 1152.9, 687.7, 1064.0 C 674.9, 1022.5, 669.3, 971.0, 673.5, 933.5 C 681.7, 859.4, 716.7, 801.3, 768.6, 775.2 C 798.0, 760.4, 827.1, 757.9, 854.5, 767.6 C 873.7, 774.4, 899.6, 789.6, 916.5, 804.0 C 961.4, 842.1, 993.4, 900.8, 1005.4, 967.0 C 1009.5, 989.7, 1010.5, 1001.2, 1010.4, 1026.5 C 1010.4, 1074.9, 1003.6, 1110.2, 988.5, 1141.5 C 965.5, 1189.1, 929.1, 1220.3, 885.8, 1229.6 C 873.9, 1232.1, 854.1, 1232.3, 844.3, 1230.1 Z M 382.0, 1225.5 C 341.9, 1218.5, 304.1, 1187.0, 281.6, 1141.6 C 269.3, 1116.9, 263.5, 1093.2, 260.9, 1056.9 C 259.7, 1041.0, 260.3, 1015.5, 262.1, 999.5 C 272.4, 908.7, 314.8, 832.2, 378.7, 789.4 C 391.5, 780.8, 412.7, 770.3, 427.1, 765.5 C 437.3, 762.1, 439.9, 761.7, 451.2, 761.2 C 466.2, 760.6, 476.9, 762.0, 490.0, 766.2 C 510.3, 772.7, 526.9, 782.9, 542.5, 798.5 C 573.4, 829.4, 592.6, 876.0, 597.1, 930.8 C 598.9, 953.4, 596.9, 987.0, 592.0, 1013.3 C 572.4, 1120.0, 511.1, 1199.0, 429.9, 1222.4 C 413.7, 1227.0, 397.1, 1228.1, 382.0, 1225.5 Z M 1140.3, 860.6 C 1073.4, 849.6, 1015.2, 803.5, 978.9, 732.6 C 962.2, 699.9, 953.8, 673.3, 947.3, 631.9 C 945.0, 617.1, 944.6, 611.5, 944.6, 594.5 C 944.6, 573.7, 945.8, 563.4, 950.1, 546.6 C 961.6, 501.5, 988.7, 464.8, 1022.4, 448.5 C 1040.8, 439.6, 1057.6, 436.3, 1076.5, 438.0 C 1122.4, 442.0, 1163.3, 462.7, 1199.7, 500.3 C 1239.8, 541.8, 1267.4, 599.2, 1276.4, 659.5 C 1278.7, 674.5, 1280.3, 704.1, 1279.6, 716.2 C 1275.9, 778.4, 1242.5, 833.1, 1196.0, 853.1 C 1178.0, 860.8, 1158.2, 863.5, 1140.3, 860.6 Z M 105.1, 834.4 C 61.6, 827.1, 25.0, 796.7, 11.5, 756.5 C 6.7, 742.3, 2.7, 722.0, 1.0, 703.5 C -5.2, 636.4, 18.4, 560.6, 62.8, 505.0 C 96.0, 463.5, 138.8, 434.8, 186.7, 421.9 C 227.0, 411.1, 263.2, 421.3, 293.9, 452.0 C 321.3, 479.4, 335.0, 519.4, 335.0, 572.1 C 335.0, 592.6, 334.0, 603.8, 330.4, 622.8 C 318.2, 688.0, 281.2, 750.4, 230.5, 791.3 C 207.2, 810.1, 175.8, 827.4, 156.0, 832.3 C 140.4, 836.2, 120.7, 837.0, 105.1, 834.4 Z M 624.0, 590.5 C 589.2, 586.6, 554.8, 577.3, 520.9, 562.4 C 469.1, 539.5, 419.1, 501.4, 386.8, 460.0 C 317.1, 370.6, 268.7, 273.8, 249.0, 184.5 C 247.8, 179.0, 245.7, 170.7, 244.4, 166.0 C 237.7, 141.7, 238.8, 114.1, 247.5, 90.0 C 261.5, 51.2, 291.8, 21.1, 329.3, 8.5 C 351.7, 1.0, 385.2, 1.1, 422.5, 8.9 C 446.8, 13.9, 465.0, 19.7, 516.6, 38.8 C 588.4, 65.5, 608.3, 70.6, 656.6, 75.1 C 678.2, 77.1, 682.1, 77.2, 697.0, 76.1 C 735.1, 73.4, 765.2, 65.1, 823.0, 41.5 C 874.2, 20.6, 902.8, 9.3, 910.0, 7.3 C 982.0, -13.1, 1053.5, 12.0, 1078.0, 66.3 C 1088.7, 90.2, 1089.9, 129.1, 1080.9, 166.0 C 1072.1, 202.0, 1046.0, 260.2, 1021.0, 299.5 C 950.5, 409.5, 900.2, 471.2, 842.0, 518.2 C 787.3, 562.3, 740.4, 583.2, 683.9, 589.5 C 668.0, 591.3, 640.3, 591.3, 624.0, 590.5 Z"
                        Fill="{Binding Color}"
                        Width="40" Height="40"
                        Stretch="Uniform"
                        RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <TransformGroup>
                                <!-- Сначала масштаб -->
                                <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
                                <!-- Потом вращение -->
                                <RotateTransform Angle="{Binding Rotation}" />
                            </TransformGroup>
                        </Path.RenderTransform>
                    </Path>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--UI -->
        <Grid ShowGridLines="False" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <Menu Grid.Row="0">
                <MenuItem Header="Info">
                    <MenuItem Header="About" Command="{Binding ClickAboutCommand}" />
                    <MenuItem Header="GitHub" Command="{Binding GitHubActionCommand}"/>
                </MenuItem>
            </Menu>

            <Grid Grid.Row="1" ShowGridLines="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"></RowDefinition>
                    <RowDefinition Height="0.1*"></RowDefinition>
                </Grid.RowDefinitions>

                <!-- IMAGE FRAME -->
                <Grid x:Name="MainGrid" Visibility="Visible" Grid.Row="0" ShowGridLines="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"></RowDefinition>
                        <RowDefinition Height="1*"></RowDefinition>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Grid.Column="0" ShowGridLines="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"></ColumnDefinition>
                            <ColumnDefinition Width="3*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <Canvas Grid.Column="1" x:Name="CropCanvas" Background="Black"
                                ClipToBounds="True"
                                MouseLeftButtonDown="CropCanvas_MouseLeftButtonDown"
                                MouseMove="CropCanvas_MouseMove"
                                MouseLeftButtonUp="CropCanvas_MouseLeftButtonUp">
                            <Image x:Name="PictureOutputMedia" IsHitTestVisible="False"
                                   Width="{Binding ActualWidth, ElementName=CropCanvas}"
                                   Height="{Binding ActualHeight, ElementName=CropCanvas}"
                                   Stretch="Uniform"
                                   Source="{Binding ImageOriginal}" />

                            <Rectangle Grid.Column="1" x:Name="SelectionRect" Fill="#4Df96a0c" Stroke="#f96a0c"
                                       StrokeThickness="2" Visibility="Collapsed">
                            </Rectangle>
                        </Canvas>

                        <ListBox x:Name="ListBox" Grid.Column="0" Background="Transparent"
                                 ItemsSource="{Binding CroppedImages}"
                                 SelectionChanged="MyListBox_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Padding" Value="5" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="Bold" Margin="0,0,10,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text"
                                                            Value="{Binding Seconds, StringFormat={}{0:F2} сек}" />
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Seconds}" Value="-1">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Text="{Binding SourceFileImageName}" FontWeight="Bold"
                                                   Margin="0,0,10,0" />

                                        <TextBlock Text="{Binding Prompt}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Remove" Click="MenuItem_OnClick"></MenuItem>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </Grid>

                    <!-- TIMELINE -->
                    <Grid Grid.Row="1" ShowGridLines="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"></ColumnDefinition>
                            <ColumnDefinition Width="2*"></ColumnDefinition>
                            <ColumnDefinition Width="1*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.8*"></RowDefinition>
                            <RowDefinition Height="2*"></RowDefinition>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" ShowGridLines="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="resX" Text="{Binding ResolutionWidth}" Grid.Column="0" Margin="2"
                                     PreviewTextInput="NumberValidationTextBox"
                                     Controls:TextBoxHelper.Watermark="Resolution W">

                            </TextBox>
                            <TextBox x:Name="resY" Grid.Column="1" Text="{Binding ResolutionHeight}" Margin="2"
                                     PreviewTextInput="NumberValidationTextBox"
                                     Controls:TextBoxHelper.Watermark="Resolution H">
                            </TextBox>
                        </Grid>

                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <Slider x:Name="slider" ValueChanged="TimeLine_ValueChanged"
                                    PreviewMouseLeftButtonUp="Slider_OnPreviewMouseLeftButtonUp">
                            </Slider>
                            <TextBlock x:Name="VideoTimelineLayout" FontSize="14" TextWrapping="Wrap"
                                       Text="{Binding VideoTimelineText}">
                            </TextBlock>
                        </StackPanel>

                        <Grid ShowGridLines="False" Grid.Row="1" Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="3*"></RowDefinition>
                                <RowDefinition Height="1*"></RowDefinition>
                            </Grid.RowDefinitions>

                            <TextBox x:Name="prompt" Grid.Row="0" KeyDown="PromptEditor_OnKeyDown"
                                     Controls:TextBoxHelper.Watermark="Enter Prompt"
                                     Text="{Binding UiPrompt, UpdateSourceTrigger=PropertyChanged}">
                            </TextBox>
                            <Button x:Name="saveBut" Grid.Row="1" Command="{Binding SaveButCommand}"
                                    Content="Save Picture And Prompt">
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1" Grid.Column="0" ShowGridLines="True">
                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>

                            <TextBox x:Name="filename" Text="{Binding ImageName}"
                                     Controls:TextBoxHelper.Watermark="Image Name">
                            </TextBox>
                        </Grid>

                        <TextBox x:Name="console" Grid.Column="2" TextChanged="Console_TextChanged" IsReadOnly="True"
                                 Text="{Binding ConsoleLog}" Grid.Row="1" Padding="0" BorderThickness="0"
                                 Controls:TextBoxHelper.Watermark="Console View">
                        </TextBox>
                    </Grid>
                </Grid>

                <!-- BOTTOM BUTTONS -->
                <Grid Grid.Row="1" ShowGridLines="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="2" x:Name="generate" Command="{Binding GenerateCommand}" Content="GENERATE!"
                            IsEnabled="True" Visibility="Visible">
                    </Button>

                    <Grid Grid.Column="0" ShowGridLines="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="filePicker" Command="{Binding FilePickerCommand}"
                                Content="Video Picker">
                        </Button>
                        <Button Grid.Column="1" x:Name="FolderPicker" Command="{Binding FolderPickerCommand}"
                                Content="Images Picker">
                        </Button>
                    </Grid>

                    <Button Grid.Column="4" Visibility="Collapsed" Content="Crop"></Button>
                    <Button Grid.Column="1" x:Name="outputFolderPicker" Command="{Binding OutputPickerCommand}"
                            Content="Output Folder Picker">
                    </Button>

                    <Controls:MetroProgressBar Grid.Column="3"
                                               Value="{Binding ProgressValue}"
                                               Maximum="{Binding ProgressMax}"
                                               Height="20"
                                               Margin="10,0"
                                               Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}" />

                    <Grid Grid.Column="4" ShowGridLines="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Controls:ToggleSwitch Grid.Column="0" Visibility="Hidden" Content="Black/Light"></Controls:ToggleSwitch>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Controls:MetroWindow>