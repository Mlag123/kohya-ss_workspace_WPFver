<Controls:MetroWindow x:Class="kohya_ss_workspace_WPFver.MainWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:local="clr-namespace:kohya_ss_workspace_WPFver"
                      xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
                      mc:Ignorable="d"
                      Title="Kohya-ssWorkspace" Height="720" Width="1280">

    <Grid ShowGridLines="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            
        </Grid.RowDefinitions>
        
        <Menu Grid.Row="0">
            <MenuItem Header="Файл">
                <MenuItem Header="Открыть..." />
                <MenuItem Header="Сохранить" />
                <Separator/>
                <MenuItem Header="Выход" />
            </MenuItem>
            <MenuItem Header="Правка">
                <MenuItem Header="Копировать"/>
                <MenuItem Header="Вставить"/>
            </MenuItem>
            <MenuItem Header="Вид">
                <MenuItem Header="Настройки"/>
            </MenuItem>
        </Menu>
        
        <Grid Grid.Row="1" ShowGridLines="True">

            <Grid.RowDefinitions>
                <RowDefinition Height="2*"></RowDefinition>
                <RowDefinition Height="0.1*"></RowDefinition>
            </Grid.RowDefinitions>
            <!-- ImageFrame -->
            <Grid x:Name="MainGrid" Visibility="Visible" Grid.Row="0" ShowGridLines="False">
                <Grid.RowDefinitions>

                    <RowDefinition Height="3*"></RowDefinition>
                    <RowDefinition Height="1*"></RowDefinition>


                </Grid.RowDefinitions>


                <Grid Grid.Row="0" Grid.Column="0" ShowGridLines="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"></ColumnDefinition>
                        <ColumnDefinition Width="3*"></ColumnDefinition>

                    </Grid.ColumnDefinitions>

                    <Canvas Grid.Column="1" x:Name="CropCanvas" Background="Black"
                            ClipToBounds="True"
                            MouseLeftButtonDown="CropCanvas_MouseLeftButtonDown"
                            MouseMove="CropCanvas_MouseMove"
                            MouseLeftButtonUp="CropCanvas_MouseLeftButtonUp">
                        <Image x:Name="PictureOutputMedia" IsHitTestVisible="False"
                               Width="{Binding ActualWidth, ElementName=CropCanvas}"
                               Height="{Binding ActualHeight, ElementName=CropCanvas}"
                               Stretch="Uniform" 
                               Source="{Binding ImageOriginal}"
                               />

                        <Rectangle Grid.Column="1" x:Name="SelectionRect" Fill="#5500FF00" Stroke="Lime"
                                   StrokeThickness="2" Visibility="Collapsed">
                        </Rectangle>

                    </Canvas>

                    <ListBox x:Name="ListBox" Grid.Column="0" SelectionChanged="MyListBox_SelectionChanged">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Выводим секунды с форматированием -->
                                    <TextBlock Text="{Binding Seconds, StringFormat={}{0:F2} сек}" FontWeight="Bold"
                                               Margin="0,0,10,0" />
                                    <!-- Выводим промпт -->
                                    <TextBlock Text="{Binding Prompt}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Test"></MenuItem>
                                </ContextMenu>
                                
                            </ListBox.ContextMenu>
                    </ListBox>

                </Grid>

                <!-- Timeline -->
                <Grid Grid.Row="1" ShowGridLines="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"></ColumnDefinition>
                        <ColumnDefinition Width="2*"></ColumnDefinition>
                        <ColumnDefinition Width="1*"></ColumnDefinition>

                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="0.8*"></RowDefinition>
                        <RowDefinition Height="2*"></RowDefinition>

                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" ShowGridLines="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="resX"  Text="{Binding ResolutionWidth}" Grid.Column="0" Margin="2" PreviewTextInput="NumberValidationTextBox"
                                 Controls:TextBoxHelper.Watermark="Resolution W">
                        </TextBox>
                        <TextBox x:Name="resY" Grid.Column="1" Text="{Binding ResolutionHeight}" Margin="2" PreviewTextInput="NumberValidationTextBox"
                                 Controls:TextBoxHelper.Watermark="Resolution H">
                        </TextBox>
                    </Grid>

                    <StackPanel Grid.Row="0" Grid.Column="1">
                        <Slider x:Name="slider" ValueChanged="TimeLine_ValueChanged"></Slider>
                        <TextBlock x:Name="VideoTimelineLayout"  FontSize="14" TextWrapping="Wrap" Text="{Binding VideoTimelineText}"></TextBlock>
                    </StackPanel>


                    <Grid ShowGridLines="False" Grid.Row="1" Grid.Column="1">

                        <Grid.RowDefinitions>

                            <RowDefinition Height="3*"></RowDefinition>
                            <RowDefinition Height="1*"></RowDefinition>

                        </Grid.RowDefinitions>

                        <TextBox x:Name="prompt" Grid.Row="0" Controls:TextBoxHelper.Watermark="Enter Prompt" Text="{Binding UiPrompt, UpdateSourceTrigger=PropertyChanged}"></TextBox>
                        <Button x:Name="saveBut" Grid.Row="1" Content="Save Picture And Prompt" Click="SaveBut_OnClick"></Button>
                    </Grid>

                    <Grid Grid.Row="1" Grid.Column="0" ShowGridLines="True">
                        <Grid.RowDefinitions>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
              


                        </Grid.RowDefinitions>

                        <TextBox x:Name="filename" Text="{Binding ImageName}" Controls:TextBoxHelper.Watermark="Image Name"></TextBox>


                    </Grid>

                    <TextBox x:Name="console" Grid.Column="2" TextChanged="Console_TextChanged" IsReadOnly="True" Text="{Binding ConsoleLog}" Grid.Row="1" Padding="0" BorderThickness="0"
                             Controls:TextBoxHelper.Watermark="Console View">
                    </TextBox>
                </Grid>


            </Grid>


            <Grid Grid.Row="1" ShowGridLines="False">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>

                </Grid.ColumnDefinitions>
                <!-- <Button x:Name="LoadEdit" Click="LoadEdit_OnClick" Grid.Column="1" Content="Load edit"></Button> -->
                <Button Grid.Column="2" x:Name="generate" Click="Generate_OnClick" Content="GENERATE!"
                        IsEnabled="False" Visibility="Visible">
                </Button>
                <Button Grid.Column="0" x:Name="filePicker" Command="{Binding FilePickerCommand}" Content="File Picker"></Button>

                <Button Grid.Column="3" Click="ButtonBase_OnClick" Content="Crop"></Button>
                <Button Grid.Column="1" x:Name="outputFolderPicker" Click="OutputFolderPicker_OnClick"
                        Content="Output Folder Picker">
                </Button>


                <Grid Grid.Column="4" ShowGridLines="True">
                    <Grid.ColumnDefinitions>

                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>

                    </Grid.ColumnDefinitions>
                    <Controls:ToggleSwitch Grid.Column="0" Content="Black/Light"></Controls:ToggleSwitch>


                </Grid>


            </Grid>

        </Grid>

    </Grid>


</Controls:MetroWindow>